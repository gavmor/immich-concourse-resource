#!/usr/bin/env python3
"""Concourse `out` script: uploads matching files as Immich assets, binding
any matching .xmp sidecar and/or .description.txt sidecar, then
resolves/creates the requested album and tags and assigns the uploaded
assets to them.

API shapes below are verified against a live Immich v3.1.0 instance's
OpenAPI spec (GET /api/spec.json), not just the AI-research doc this was
drafted from. See README.md "Known limitations" for the album-creation
race condition this script cannot fully close.
"""
import glob
import hashlib
import json
import os
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from contextlib import ExitStack
from datetime import datetime, timezone

import requests
from requests.adapters import HTTPAdapter
from urllib3.util import Retry

UPLOAD_WORKERS = 4


def log(message):
    print(message, file=sys.stderr)


def create_session(api_key, pool_size=UPLOAD_WORKERS):
    session = requests.Session()
    session.headers.update({
        "x-api-key": api_key,
        "Accept": "application/json",
    })
    retries = Retry(
        total=4,
        backoff_factor=0.5,
        status_forcelist=[502, 503, 504],
        raise_on_status=False,
    )
    adapter = HTTPAdapter(
        pool_connections=pool_size,
        pool_maxsize=pool_size,
        max_retries=retries,
    )
    session.mount("http://", adapter)
    session.mount("https://", adapter)
    return session


def calculate_checksum(file_path):
    """SHA-1 of file contents. Used only for dedup/tracking in build
    metadata -- NOT a cryptographic integrity guarantee, and callers
    should not treat it as one."""
    hasher = hashlib.sha1()
    with open(file_path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def find_xmp_sidecar(file_path):
    base_path, _ext = os.path.splitext(file_path)
    for candidate in (f"{base_path}.xmp", f"{file_path}.xmp"):
        if os.path.isfile(candidate):
            return candidate
    return None


def find_description_sidecar(file_path):
    """A plain-UTF-8-text `.description.txt` sidecar, checked the same two
    ways as find_xmp_sidecar (base-name and full-filename). Deliberately
    separate from XMP sidecar binding: a caller that just wants a per-asset
    description set (the common case -- e.g. a generation prompt) shouldn't
    have to hand-build an XMP envelope and worry about XML-escaping its own
    text to get one string into Immich. Read via the direct
    `PUT /api/assets/{id}` description field (see set_description below)
    rather than folding into the XMP sidecar upload path, since that field
    updates synchronously -- no dependency on Immich's own async
    metadata-extraction job the way an XMP sidecar's dc:description is."""
    base_path, _ext = os.path.splitext(file_path)
    for candidate in (f"{base_path}.description.txt", f"{file_path}.description.txt"):
        if os.path.isfile(candidate):
            return candidate
    return None


def resolve_or_create_album(session, host, album_identifier):
    """Resolve an album name to its UUID, creating it if no album with
    that name exists yet. UUIDs are passed through unchanged.

    Known race: Immich has no unique constraint on albumName and no
    upsert-by-name endpoint (unlike tags, see resolve_or_create_tags), so
    this is an unavoidable check-then-create. Two concurrent `out` runs
    targeting a brand-new album name can both miss the "already exists"
    check and each create their own album. See README.md for mitigation
    (serialize jobs that create new albums)."""
    if len(album_identifier) == 36 and album_identifier.count("-") == 4:
        return album_identifier

    response = session.get(f"{host}/api/albums", timeout=30)
    response.raise_for_status()
    for album in response.json():
        if album.get("albumName", "").lower() == album_identifier.lower():
            log(f"Found existing album '{album_identifier}' with ID: {album['id']}")
            return album["id"]

    log(f"Album '{album_identifier}' not found. Creating a new album...")
    response = session.post(
        f"{host}/api/albums",
        json={"albumName": album_identifier},
        timeout=30,
    )
    response.raise_for_status()
    album_id = response.json()["id"]
    log(f"Created album '{album_identifier}' with ID: {album_id}")
    return album_id


def resolve_or_create_tags(session, host, tag_names):
    """Resolve tag names to UUIDs via Immich's atomic upsert endpoint
    (PUT /api/tags), which creates-or-updates all given names in a single
    server-side transaction. This closes the race that a manual
    get-then-create pattern would have -- unlike albums, Immich has no
    such upsert for albums."""
    if not tag_names:
        return []

    response = session.put(
        f"{host}/api/tags", json={"tags": tag_names}, timeout=30
    )
    response.raise_for_status()
    by_name = {tag["name"].lower(): tag["id"] for tag in response.json()}
    return [by_name[name.lower()] for name in tag_names if name.lower() in by_name]


def set_description(session, host, asset_id, description):
    """PUT /api/assets/{id} {"description": ...} -- confirmed against a live
    Immich v3.1.0 instance's own OpenAPI spec (AssetBulkUpdateDto's
    per-asset counterpart) and already exercised by a real caller: the
    gavmor/blades68-lora comfyui-render pipeline's caption-reference-archive
    job writes captions back this exact way. Returns True on success; the
    caller logs and moves on rather than failing the whole upload over a
    description that didn't stick, matching this script's existing
    warn-not-abort handling of the album/tag bulk-assignment endpoints."""
    response = session.put(
        f"{host}/api/assets/{asset_id}",
        json={"description": description},
        timeout=30,
    )
    return response.status_code == 200


def upload_single_file(args):
    file_path, host, upload_url, session, is_favorite, visibility = args
    filename = os.path.basename(file_path)

    stat_info = os.stat(file_path)
    created_at = datetime.fromtimestamp(stat_info.st_ctime, tz=timezone.utc).isoformat()
    modified_at = datetime.fromtimestamp(stat_info.st_mtime, tz=timezone.utc).isoformat()
    checksum = calculate_checksum(file_path)

    # NOTE: deliberately no top-level "filename" field in `data`. Immich's
    # canUploadFile() reuses body.filename (if present) as the extension
    # source for EVERY multipart field's type check, not just assetData --
    # so setting it here makes the sidecar's own .xmp extension check run
    # against the *asset's* filename/extension instead and fail with
    # "Unsupported file type". Leaving it unset makes Immich fall back to
    # each part's own filename, which is what we actually want. Verified
    # against a live v3.1.0 instance: 2026-08-24.
    data = {
        "fileCreatedAt": created_at,
        "fileModifiedAt": modified_at,
        "isFavorite": "true" if is_favorite else "false",
        "visibility": visibility,
    }

    try:
        with ExitStack() as stack:
            img_f = stack.enter_context(open(file_path, "rb"))
            files = {"assetData": (filename, img_f, "application/octet-stream")}

            sidecar_path = find_xmp_sidecar(file_path)
            if sidecar_path:
                log(f"Auto-detected XMP sidecar for {filename}: {os.path.basename(sidecar_path)}")
                sidecar_f = stack.enter_context(open(sidecar_path, "rb"))
                files["sidecarData"] = (os.path.basename(sidecar_path), sidecar_f, "application/xml")

            response = session.post(upload_url, data=data, files=files, timeout=120)

            if response.status_code in (200, 201):
                resp_data = response.json()
                asset_id = resp_data["id"]

                description_bound = False
                description_path = find_description_sidecar(file_path)
                if description_path:
                    with open(description_path, "r", encoding="utf-8") as desc_f:
                        description_text = desc_f.read().strip()
                    if description_text:
                        log(f"Auto-detected description sidecar for {filename}: {os.path.basename(description_path)}")
                        if set_description(session, host, asset_id, description_text):
                            description_bound = True
                        else:
                            log(f"Warning: description sidecar found for {filename} but PUT /api/assets/{asset_id} failed -- upload itself still succeeded")

                return {
                    "success": True,
                    "filename": filename,
                    "id": asset_id,
                    "status": resp_data.get("status", "unknown"),
                    "checksum": checksum,
                    "has_sidecar": sidecar_path is not None,
                    "has_description": description_bound,
                }

            return {
                "success": False,
                "filename": filename,
                "error": f"HTTP {response.status_code}: {response.text}",
            }
    except Exception as e:
        return {"success": False, "filename": filename, "error": str(e)}


def main():
    if len(sys.argv) < 2:
        log("Error: missing target build directory argument.")
        sys.exit(1)

    build_dir = sys.argv[1]

    try:
        input_data = json.load(sys.stdin)
    except Exception as e:
        log(f"Error parsing input JSON: {e}")
        sys.exit(1)

    source = input_data.get("source", {})
    host = source.get("host")
    api_key = source.get("api_key")
    if not host or not api_key:
        log("Error: both 'host' and 'api_key' must be set in the resource source config.")
        sys.exit(1)
    host = host.rstrip("/")

    params = input_data.get("params", {})
    file_glob = params.get("glob")
    if not file_glob:
        log("Error: 'glob' must be set in put params.")
        sys.exit(1)
    is_favorite = str(params.get("is_favorite", "false")).lower() == "true"
    visibility = params.get("visibility", "timeline")
    album_identifier = params.get("album") or params.get("album_id")
    tags_list = params.get("tags", [])

    search_pattern = os.path.join(build_dir, file_glob)
    matching_files = [
        f for f in glob.glob(search_pattern)
        if os.path.isfile(f)
        and not f.lower().endswith(".xmp")
        and not f.lower().endswith(".description.txt")
    ]

    if not matching_files:
        log(f"Warning: no files matched glob pattern: {file_glob}")
        print(json.dumps({
            "version": {"ref": datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")},
            "metadata": [{"name": "uploaded_assets_count", "value": "0"}],
        }))
        return

    session = create_session(api_key)
    album_id = resolve_or_create_album(session, host, album_identifier) if album_identifier else None
    tag_ids = resolve_or_create_tags(session, host, tags_list) if tags_list else []

    upload_url = f"{host}/api/assets"
    log(f"Uploading {len(matching_files)} asset(s) with {UPLOAD_WORKERS} worker(s)...")

    uploaded_assets = []
    failed_uploads = []
    duplicates = 0
    sidecars_bound = 0
    descriptions_bound = 0

    tasks = [(f, host, upload_url, session, is_favorite, visibility) for f in matching_files]
    with ThreadPoolExecutor(max_workers=UPLOAD_WORKERS) as executor:
        futures = {executor.submit(upload_single_file, task): task[0] for task in tasks}
        for future in as_completed(futures):
            res = future.result()
            if res["success"]:
                uploaded_assets.append(res)
                if res["status"] == "duplicate":
                    duplicates += 1
                if res["has_sidecar"]:
                    sidecars_bound += 1
                if res["has_description"]:
                    descriptions_bound += 1
                log(f"Uploaded {res['filename']} -> {res['id']} ({res['status']})")
            else:
                failed_uploads.append(res)
                log(f"Error: failed to upload {res['filename']}: {res['error']}")

    if failed_uploads:
        failed_names = ", ".join([f["filename"] for f in failed_uploads])
        log(f"Fatal: {len(failed_uploads)} asset upload(s) failed for [{failed_names}]. Aborting build step.")
        sys.exit(1)

    uploaded_asset_ids = [a["id"] for a in uploaded_assets]

    if album_id and uploaded_asset_ids:
        log(f"Assigning {len(uploaded_asset_ids)} asset(s) to album '{album_identifier}' ({album_id})")
        response = session.put(
            f"{host}/api/albums/{album_id}/assets",
            json={"ids": uploaded_asset_ids},
            timeout=60,
        )
        if response.status_code != 200:
            log(f"Warning: album assignment failed. HTTP {response.status_code}: {response.text}")
        else:
            # Response is an array of per-asset {id, success, error} results
            # (BulkIdResponseDto) -- a 200 overall can still contain individual
            # failures, so check each rather than trusting the status code alone.
            for item in response.json():
                if isinstance(item, dict) and not item.get("success", True):
                    log(f"Warning: album assignment failed for asset {item.get('id')}: {item.get('error')}")

    if tag_ids and uploaded_asset_ids:
        log(f"Assigning {len(uploaded_asset_ids)} asset(s) to {len(tag_ids)} tag(s)")
        response = session.put(
            f"{host}/api/tags/assets",
            json={"tagIds": tag_ids, "assetIds": uploaded_asset_ids},
            timeout=60,
        )
        if response.status_code != 200:
            log(f"Warning: tag assignment failed. HTTP {response.status_code}: {response.text}")
        else:
            # Response is {"count": N} (TagBulkAssetsResponseDto) -- the
            # number of asset-tag associations actually made, which should
            # equal len(tag_ids) * len(uploaded_asset_ids).
            expected = len(tag_ids) * len(uploaded_asset_ids)
            actual = response.json().get("count", 0)
            if actual < expected:
                log(f"Warning: tag assignment made {actual}/{expected} associations; some assets may be missing tags.")

    uploaded_assets_meta = [
        f"{a['filename']} (ID: {a['id']}, SHA-1: {a['checksum'][:8]}, status: {a['status']})"
        + (" [XMP bound]" if a["has_sidecar"] else "")
        + (" [description bound]" if a["has_description"] else "")
        for a in uploaded_assets
    ]

    print(json.dumps({
        "version": {"ref": datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")},
        "metadata": [
            {"name": "uploaded_assets_count", "value": str(len(uploaded_asset_ids))},
            {"name": "duplicate_assets_count", "value": str(duplicates)},
            {"name": "xmp_sidecars_bound", "value": str(sidecars_bound)},
            {"name": "descriptions_bound", "value": str(descriptions_bound)},
            {"name": "assets_meta", "value": ", ".join(uploaded_assets_meta) if uploaded_assets_meta else "none"},
            {"name": "album_assigned", "value": str(album_identifier) if album_id else "none"},
            {"name": "tags_assigned", "value": ", ".join(tags_list) if tags_list else "none"},
        ],
    }))


if __name__ == "__main__":
    main()
