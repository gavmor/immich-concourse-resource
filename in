#!/usr/bin/env python3
"""Concourse `in` script. This is a put-only resource: there is no upstream
content to fetch, so `get` just echoes back whatever version `out` produced."""
import json
import os
import sys


def main():
    destination_dir = sys.argv[1] if len(sys.argv) > 1 else "/tmp"
    os.makedirs(destination_dir, exist_ok=True)

    try:
        input_data = json.load(sys.stdin)
    except Exception as e:
        print(f"Error parsing input: {e}", file=sys.stderr)
        sys.exit(1)

    print(json.dumps({
        "version": input_data.get("version", {}),
        "metadata": [{"name": "status", "value": "in-step-pass-through"}],
    }))


if __name__ == "__main__":
    main()
